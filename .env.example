# PostgreSQL — formato .NET: Host=...;Port=...;Database=...;Username=...;Password=...
DB_CONNECTION_STRING="Host=your-host;Port=5432;Database=your-db;Username=postgres;Password=your-password"

# Límite de filas por consulta
DB_MAX_ROWS=1000

# Ollama — modelo de lenguaje local/cloud
OLLAMA_BASE_URL="https://ollama.com"
OLLAMA_API_KEY="your-ollama-api-key"
OLLAMA_MODEL="qwen3-coder:480b-cloud"

# HuggingFace — para embeddings y modelos alternativos
HUGGINGFACE_API_KEY="hf_your-api-key"

# RAG — configuración del pipeline de Retrieval-Augmented Generation
Rag__ChunkSize=500
Rag__ChunkOverlap=50
Rag__EmbeddingDimension=768
Rag__EmbeddingModel="nomic-embed-text"
Rag__TopK=5

# FastFixPro — API externa
FASTFIXPRO_API_BASE_URL="https://fastfixpro-production.up.railway.app"
FASTFIXPRO_API_TOKEN="your-jwt-token"
